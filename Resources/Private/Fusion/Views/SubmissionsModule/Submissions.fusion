Wwwision.Neos.Submissions.SubmissionsModuleController.submissions = NeosBE:Module {
  translateContent = true
  content = afx`
    <Neos.Fusion.Form:Form attributes.class="filter" form.data.preset={preset.id} form.data.filter={Json.parse(Json.stringify(filter))} form.method="GET" form.enableReferrer={false} form.target.action="submissions">
      <Neos.Fusion.Form:Neos.BackendModule.FieldContainer field.name="preset" attributes.class="neos-span3 neos-select">
        <Neos.Fusion.Form:Select attributes.onchange="this.form.submit()">
          <Neos.Fusion.Form:Select.Option option.value="" content="- LLL:selectPreset -" />
          <Neos.Fusion:Loop items={presets} itemName="preset">
            <Neos.Fusion.Form:Select.Option option.value={preset.id} content={String.htmlSpecialChars(preset.title.value)} attributes.title={'ID: ' + preset.id} />
          </Neos.Fusion:Loop>
        </Neos.Fusion.Form:Select>
      </Neos.Fusion.Form:Neos.BackendModule.FieldContainer>
      <Neos.Fusion.Form:Neos.BackendModule.FieldContainer field.name="filter[formId]" attributes.class="neos-span3 neos-select">
        <Neos.Fusion.Form:Select attributes.onchange="this.form.submit()" @if.hasMultipleForms={Array.length(forms) > 1}>
          <Neos.Fusion.Form:Select.Option option.value="">
            <NeosBE:Translate id="filter.formId.all" arguments={[preset.title.value]} />
          </Neos.Fusion.Form:Select.Option>
          <Neos.Fusion:Loop items={forms} itemName="form">
            <Neos.Fusion.Form:Select.Option option.value={form.id} content={String.htmlSpecialChars(form.label.value)} attributes.title={'ID: ' + form.id} />
          </Neos.Fusion:Loop>
        </Neos.Fusion.Form:Select>
        <Neos.Fusion.Form:Select attributes.disabled={true} @if.hasMultipleForms={Array.length(forms) <= 1}>
          <Neos.Fusion:Loop items={forms} itemName="form">
            <Neos.Fusion.Form:Select.Option option.value={form.id} content={String.htmlSpecialChars(form.label.value)} attributes.title={'ID: ' + form.id} />
          </Neos.Fusion:Loop>
        </Neos.Fusion.Form:Select>
      </Neos.Fusion.Form:Neos.BackendModule.FieldContainer>
      <Neos.Fusion.Form:Neos.BackendModule.FieldContainer field.name="filter[searchTerm]" attributes.class="neos-span3">
        <Neos.Fusion.Form:Input attributes.type="search" attributes.placeholder="LLL:filter.searchTerm.placeholder" />
      </Neos.Fusion.Form:Neos.BackendModule.FieldContainer>
      <div class="filter-submit">
        <NeosBE:Button isPrimary={true} content="LLL:filter.apply" />
      </div>
    </Neos.Fusion.Form:Form>
    <p @if.hasNoSubmissions={submissions.empty}><i>LLL:noSubmissionsMatchFilter</i></p>
    <Neos.Fusion:Fragment @if.hasSubmissions={!submissions.empty}>
      <h2><NeosBE:Translate id="numberOfSubmissionsMatchFilter" quantity={submissions.totalCount} arguments={[submissions.totalCount]} /></h2>
      <NeosBE:Table>
        <NeosBE:Table.Head>
          <NeosBE:Table.Row>
            <NeosBE:Table.HeaderCell attributes.style="width: 1em"/>
            <NeosBE:Table.HeaderCell content="LLL:submission.label"/>
            <NeosBE:Table.HeaderCell content="LLL:submission.creationDate"/>
            <NeosBE:Table.HeaderCell/>
          </NeosBE:Table.Row>
        </NeosBE:Table.Head>
        <NeosBE:Table.Body>
          <Neos.Fusion:Loop items={submissions} itemName="submission">
            <NeosBE:Table.ClickableRow target.action="show" target.arguments={{preset: preset.id.value, id: submission.id.value, filter: filter.array}}>
              <NeosBE:Table.Cell>
                <NeosBE:Icon icon="envelope-circle-check"/>
              </NeosBE:Table.Cell>
              <NeosBE:Table.Cell>
                {String.htmlSpecialChars(submission.label.value)}
              </NeosBE:Table.Cell>
              <NeosBE:Table.Cell>
                <Wwwision.Neos.Submissions:Timestamp dateTime={submission.createdAt} />
              </NeosBE:Table.Cell>
              <NeosBE:Table.ActionCell>
                <NeosBE:Button icon="eye" action="show" arguments={{preset: preset.id.value, id: submission.id.value, filter: filter.array}}/>
              </NeosBE:Table.ActionCell>
            </NeosBE:Table.ClickableRow>
          </Neos.Fusion:Loop>
        </NeosBE:Table.Body>
      </NeosBE:Table>
      <NeosBE:Pagination numberOfResults={submissions.totalCount} resultsPerPage={pagination.resultsPerPage} />
    </Neos.Fusion:Fragment>
  `

  footer = afx`
    <NeosBE:Button action="download" arguments={{preset: preset.id.value, filter: filter.array}} renderer.linkButton.renderer.href.format="csv" content="LLL:csvDownload" attributes.download={Date.format(Date.now(), 'Ymdhis') + '-' + String.rawUrlEncode(preset.title.value) + (filter.empty ? '' : '-filtered') + '.csv'} icon="download" />
  `
}
